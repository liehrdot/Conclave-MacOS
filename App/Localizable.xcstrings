        }
      }
    },
    "Conclave restarted in the background. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclave wurde im Hintergrund neu gestartet. Versuch es gleich noch einmal."
          }
        }
      }
    },
    "Conclave sent an answer this app doesn't understand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclave hat eine Antwort geschickt, die diese App nicht versteht."
          }
        }
      }
    },
