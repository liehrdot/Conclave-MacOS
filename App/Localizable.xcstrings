    "The deck file is damaged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Deck-Datei ist beschädigt."
          }
        }
      }
    },
    "The part of Conclave that checks decks and keeps your data stopped several times in a row.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Teil von Conclave, der Decks prüft und deine Daten verwaltet, ist mehrmals hintereinander ausgefallen."
          }
        }
      }
    },
    "This copy of the app was built without its engine. Run scripts/build_engine.sh, then build the app again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wurde ohne ihren Hintergrunddienst gebaut. Führe scripts/build_engine.sh aus und baue die App dann neu."
          }
        }
      }
    },
    "This isn't there any more. It may have been deleted on another device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gibt es nicht mehr. Vielleicht wurde es auf einem anderen Gerät gelöscht."
