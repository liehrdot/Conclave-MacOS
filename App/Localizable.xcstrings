      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclave"
          }
        }
      }
    },
    "Conclave Couldn't Start": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclave konnte nicht starten"
          }
        }
      }
    },
    "Conclave couldn't do that (error %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt (Fehler %lld)."
