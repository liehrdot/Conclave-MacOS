          "stringUnit": {
            "state": "translated",
            "value": "Bracket"
          }
        }
      }
    },
    "Changed on another device. The deck check runs again soon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen Gerät geändert. Der Deck-Check läuft gleich erneut."
          }
        }
      }
    },
    "Choose a deck in the sidebar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle links in der Seitenleiste ein Deck."
          }
        }
      }
    },
